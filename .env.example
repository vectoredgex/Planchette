# Optional. Planchette runs fully offline without this.
# With a key, missing sound effects are generated once (saved in sounds/)
# and the mic button lets you ask questions out loud.
# Get a key at https://elevenlabs.io (Developers > API Keys).
# It needs the "Sound Effects" and "Speech to Text" permissions.
ELEVENLABS_API_KEY=

# Optional overrides
# OLLAMA_HOST=http://127.0.0.1:11434
# PLANCHETTE_PORT=7666
